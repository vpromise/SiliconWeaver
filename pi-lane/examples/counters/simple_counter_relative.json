          {"drive": {"rst_n": 1, "enable": 0}, "repeat": 2},
          {"drive": {"rst_n": 1, "enable": 1}, "repeat": 1}
        ]
      },
      {
        "id": "TEST_WRAPAROUND",
        "description": "Increment through the complete 4-bit range and beyond to observe 14, 15, 0, and 1 across the wrap boundary.",
        "requirement_ids": ["REQ_INCREMENT", "REQ_WRAP", "REQ_WIDTH"],
        "reset_before": true,
        "cycles": [
          {"drive": {"rst_n": 1, "enable": 1}, "repeat": 18}
        ]
      },
      {
        "id": "TEST_RESET_PRIORITY_AND_RECOVERY",
