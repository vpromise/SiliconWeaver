{
  "schema_version": 1,
  "design": {
    "name": "simple_counter",
    "description": "Implement a synthesizable 4-bit unsigned synchronous up counter in Verilog. The top-level module must be named simple_counter and must exactly match the declared interface. All state updates occur on the rising edge of clk. Active-low synchronous reset rst_n has highest priority: when rst_n is sampled low, count becomes 0 regardless of enable. Otherwise, when enable is sampled high, count increments by one modulo 16, including automatic wrap from 15 to 0. When enable is sampled low, count holds its previous value. The registered count output reflects the updated state after the sampling edge and combinational settling. Reset has no asynchronous effect between clock edges.",
    "pdk": "sky130A",
    "ports": [
      {"name": "clk", "direction": "input", "width": 1, "signed": false},
      {"name": "rst_n", "direction": "input", "width": 1, "signed": false},
      {"name": "enable", "direction": "input", "width": 1, "signed": false},
      {"name": "count", "direction": "output", "width": 4, "signed": false}
    ],
    "clock": {"port": "clk", "period_ns": 10.0},
    "reset": {"port": "rst_n", "active_low": true, "asynchronous": false},
    "architecture": {}
  },
  "flow": {
    "name": "Classic",
    "to": null,
    "mapped_equivalence_mode": "required",
    "floorplan_sizing": "relative",
    "core_utilization": 40,
