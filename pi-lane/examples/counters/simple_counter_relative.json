  },
  "verification": {
    "requirements": [
      {
        "id": "REQ_RESET",
        "text": "A rising edge that samples rst_n low synchronously sets count to zero.",
        "kind": "reset",
        "signals": ["rst_n", "count"]
      },
      {
        "id": "REQ_INCREMENT",
        "text": "When a rising edge samples rst_n high and enable high, count increments by exactly one modulo 16 and the updated value is visible after that edge.",
        "kind": "functional",
        "signals": ["rst_n", "enable", "count"],
        "latency_cycles": 0
      },
      {
        "id": "REQ_WRAP",
        "text": "When count is 15 and a rising edge samples rst_n high and enable high, count wraps to zero.",
        "kind": "functional",
        "signals": ["rst_n", "enable", "count"]
      },
      {
        "id": "REQ_HOLD",
        "text": "When a rising edge samples rst_n high and enable low, count holds its previous value.",
        "kind": "invariant",
        "signals": ["rst_n", "enable", "count"]
      },
      {
        "id": "REQ_PRIORITY",
        "text": "Synchronous reset has higher priority than enable, so a rising edge sampling rst_n low and enable high sets count to zero instead of incrementing.",
        "kind": "protocol",
        "signals": ["rst_n", "enable", "count"]
      },
      {
        "id": "REQ_WIDTH",
        "text": "count is an unsigned 4-bit registered output and therefore represents only values from 0 through 15.",
        "kind": "invariant",
        "signals": ["count"]
      }
    ],
    "directed_tests": [
      {
        "id": "TEST_RESET_AND_IDLE_HOLD",
        "description": "Apply the standard synchronous reset, then hold enable low for multiple cycles and require count to remain zero.",
        "requirement_ids": ["REQ_RESET", "REQ_HOLD", "REQ_WIDTH"],
        "reset_before": true,
        "cycles": [
          {"drive": {"rst_n": 1, "enable": 0}, "repeat": 4}
        ]
      },
      {
        "id": "TEST_CONSECUTIVE_INCREMENT",
        "description": "Starting from reset, enable five consecutive increments, hold for two cycles, then increment once more.",
        "requirement_ids": ["REQ_INCREMENT", "REQ_HOLD", "REQ_WIDTH"],
        "reset_before": true,
        "cycles": [
